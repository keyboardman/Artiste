{% extends 'admin/base.html.twig' %}

{% block title %}Catégories{% endblock %}
{% block page_title %}Gestion des catégories{% endblock %}

{% block content %}
    <div class="mb-3">
        <a href="{{ path('app_admin_category_new') }}" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nouvelle catégorie
        </a>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Liste des catégories</h5>
            <span class="text-muted">Total : {{ categories|length }}</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Nom</th>
                        <th>Slug</th>
                        <th>Articles</th>
                        <th>Description</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for category in categories %}
                        <tr>
                            <td>{{ category.id }}</td>
                            <td><strong>{{ category.name }}</strong></td>
                            <td><code>{{ category.slug }}</code></td>
                            <td>{{ category.articles|length }}</td>
                            <td>{{ category.description|default('—')|length > 60 ? category.description|slice(0, 60) ~ '...' : category.description|default('—') }}</td>
                            <td class="text-end">
                                <a href="{{ path('app_admin_category_edit', {id: category.id}) }}" class="btn btn-sm btn-warning"><i class="fas fa-edit"></i></a>
                                <button type="button" class="btn btn-sm btn-danger"
                                        onclick="confirmDelete({{ category.id }}, '{{ category.name|e('js') }}')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="text-center text-muted py-4">Aucune catégorie</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <form id="delete-form" method="post" style="display:none;">
        <input type="hidden" name="_token" id="delete-token">
    </form>
{% endblock %}

{% block javascripts %}
<script>
    function confirmDelete(id, name) {
        if (!confirm('Supprimer la catégorie "' + name + '" ?')) return;
        const form = document.getElementById('delete-form');
        form.action = '/admin/categories/' + id + '/delete';
        document.getElementById('delete-token').value = 'delete_category_' + id;
        form.submit();
    }
</script>
{% endblock %}
