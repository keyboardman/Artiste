{% extends 'admin/base.html.twig' %}

{% block title %}Commande #{{ order.id }}{% endblock %}
{% block page_title %}Commande #{{ order.id }} {% if order.reference %}<small class="text-muted fs-6">({{ order.reference }})</small>{% endif %}{% endblock %}

{% block content %}
    <div class="mb-3">
        <a href="{{ path('app_admin_orders') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Retour
        </a>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header"><h5 class="mb-0">Articles</h5></div>
                <div class="card-body p-0">
                    <table class="table mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Article</th>
                                <th class="text-center">Prix unitaire</th>
                                <th class="text-center">Quantité</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in order.items %}
                                <tr>
                                    <td>
                                        {% if item.image %}
                                            <img src="{{ asset(item.image) }}" alt="" style="width:48px;height:48px;object-fit:cover;border-radius:4px;" class="me-2">
                                        {% endif %}
                                        {{ item.title }}
                                        {% if item.article %}
                                            <a href="{{ path('app_article_show', {id: item.article.id}) }}" target="_blank" class="ms-2"><i class="fas fa-external-link-alt small"></i></a>
                                        {% endif %}
                                    </td>
                                    <td class="text-center">{{ item.unitPrice|number_format(2, ',', ' ') }} €</td>
                                    <td class="text-center">{{ item.quantity }}</td>
                                    <td class="text-end">{{ item.lineTotal|number_format(2, ',', ' ') }} €</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <th colspan="3" class="text-end">TOTAL</th>
                                <th class="text-end">{{ order.total|number_format(2, ',', ' ') }} €</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header"><h5 class="mb-0">Statut</h5></div>
                <div class="card-body">
                    <p>
                        Actuel :
                        <span class="badge {{ order.status.badgeClass }} fs-6">{{ order.status.label }}</span>
                    </p>
                    <form method="post" action="{{ path('app_admin_order_status', {id: order.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('order_status_' ~ order.id) }}">
                        <select name="status" class="form-select mb-2">
                            {% for s in statuses %}
                                <option value="{{ s.value }}" {{ s == order.status ? 'selected' : '' }}>{{ s.label }}</option>
                            {% endfor %}
                        </select>
                        <button type="submit" class="btn btn-warning w-100">
                            <i class="fas fa-sync"></i> Mettre à jour
                        </button>
                    </form>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header"><h5 class="mb-0">Client</h5></div>
                <div class="card-body">
                    <p class="mb-1"><strong>{{ order.user.firstname }} {{ order.user.lastname }}</strong></p>
                    <p class="mb-1 text-muted">{{ order.user.email }}</p>
                    <a href="{{ path('app_admin_user_show', {id: order.user.id}) }}" class="btn btn-sm btn-outline-primary mt-2">
                        Voir le profil
                    </a>
                </div>
            </div>

            <div class="card">
                <div class="card-header"><h5 class="mb-0">Informations</h5></div>
                <div class="card-body">
                    <p class="mb-1"><strong>Créée le :</strong><br>{{ order.createdAt|date('d/m/Y H:i') }}</p>
                    {% if order.updatedAt %}
                        <p class="mb-0"><strong>Mise à jour :</strong><br>{{ order.updatedAt|date('d/m/Y H:i') }}</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
