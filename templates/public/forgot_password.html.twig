{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié - Placeaupro{% endblock %}

{% block body_class %}login-page{% endblock %}

{% block nav_style %}white{% endblock %}

{% block responsive_css %}{% endblock %}

{% block content %}
    <main class="login-main">
        <div class="login-container">
            <h2 style="text-align:center;letter-spacing:2px;margin-bottom:24px;">MOT DE PASSE OUBLIÉ</h2>

            <p style="text-align:center;color:#666;margin-bottom:24px;">
                Saisissez l'adresse email associée à votre compte. Nous vous enverrons un lien pour réinitialiser votre mot de passe.
            </p>

            {% for message in app.flashes('error') %}
                <div class="login-error">{{ message }}</div>
            {% endfor %}

            <form method="post" action="{{ path('app_forgot_password') }}" class="login-form">
                <input type="hidden" name="_token" value="{{ csrf_token('forgot_password') }}">

                <input type="email"
                       name="email"
                       required
                       class="login-input"
                       placeholder="ADRESSE MAIL">

                <div class="login-actions">
                    <a href="{{ path('app_login') }}" class="login-button login-button--secondary">
                        RETOUR
                    </a>
                    <button type="submit" class="login-button login-button--primary">
                        ENVOYER LE LIEN
                    </button>
                </div>
            </form>
        </div>
    </main>
{% endblock %}
