{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe - Placeaupro{% endblock %}

{% block body_class %}login-page{% endblock %}

{% block nav_style %}white{% endblock %}

{% block responsive_css %}{% endblock %}

{% block content %}
    <main class="login-main">
        <div class="login-container">
            <h2 style="text-align:center;letter-spacing:2px;margin-bottom:24px;">NOUVEAU MOT DE PASSE</h2>

            <p style="text-align:center;color:#666;margin-bottom:24px;">
                Choisissez un nouveau mot de passe pour votre compte.
            </p>

            {% for message in app.flashes('error') %}
                <div class="login-error">{{ message }}</div>
            {% endfor %}

            <form method="post"
                  action="{{ path('app_reset_password', {token: token}) }}"
                  class="login-form">
                <input type="hidden" name="_token" value="{{ csrf_token('reset_password') }}">

                <input type="password"
                       name="password"
                       required
                       minlength="6"
                       autocomplete="new-password"
                       class="login-input"
                       placeholder="NOUVEAU MOT DE PASSE">

                <input type="password"
                       name="password_confirm"
                       required
                       minlength="6"
                       autocomplete="new-password"
                       class="login-input"
                       placeholder="CONFIRMATION">

                <div class="login-actions">
                    <a href="{{ path('app_login') }}" class="login-button login-button--secondary">
                        ANNULER
                    </a>
                    <button type="submit" class="login-button login-button--primary">
                        VALIDER
                    </button>
                </div>
            </form>
        </div>
    </main>
{% endblock %}
