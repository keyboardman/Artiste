{% extends 'base.html.twig' %}

{% block title %}Placeaupro - {{ article.title|default('Achat') }}{% endblock %}

{% block body_class %}achat-page{% endblock %}

{% block nav_transparent %}true{% endblock %}

{% block content %}
    <section id="article">
        <div class="article-container">
            {# IMAGE PRINCIPALE + GALERIE #}
            <div class="article-image">
                {% set has_gallery = images|length > 1 %}

                <img id="article-main-image"
                     src="{{ asset(images[0]|default('img/article.jpg')) }}"
                     alt="{{ article.title|default('Oeuvre') }}" />

                {% if has_gallery %}
                    <div class="article-image-thumbs"
                         style="display:flex;gap:8px;margin-top:12px;flex-wrap:wrap;">
                        {% for path in images %}
                            <button type="button"
                                    class="article-thumb {{ loop.first ? 'active' : '' }}"
                                    data-image="{{ asset(path) }}"
                                    style="width:60px;height:60px;border:2px solid {{ loop.first ? '#000' : 'transparent' }};padding:0;cursor:pointer;background:#fff;">
                                <img src="{{ asset(path) }}"
                                     alt="Vignette {{ loop.index }}"
                                     style="width:100%;height:100%;object-fit:cover;display:block;">
                            </button>
                        {% endfor %}
                    </div>
                {% endif %}

                <div class="article-image-index">
                    {% for i in 1..(images|length > 0 ? images|length : 1) %}
                        <span class="{% if loop.first %}active{% endif %}">{{ '%02d'|format(i) }}</span>
                    {% endfor %}
                </div>
            </div>

            {# TEXTE #}
            <div class="article-content">
                <div class="article-description">
                    <h2 class="article-title">{{ article.title|default("NOM DE L'ŒUVRE")|upper }}</h2>

                    <p class="article-text">
                        {{ article.description|default("Aucune description pour cette œuvre.") }}
                    </p>

                    <hr />

                    <h3 class="article-subtitle">
                        INFOS SUR L'ARTISTE

                        <p class="article-text small">
                            {% if artist.name %}<strong>{{ artist.name }}</strong> — {% endif %}
                            {{ artist.biography }}
                        </p>
                    </h3>
                </div>

                <button class="article-btn"
                        data-add-cart="{{ path('app_cart_add', {id: article.id}) }}">
                    AJOUTER AU PANIER
                </button>
            </div>
        </div>
    </section>

    <section id="artiste-banner">
        <div class="artiste-banner-container">
            <div class="artiste-banner-image">
                <img src="{{ asset(artist.image) }}" alt="Image de l'artiste" />
                <span class="artiste-banner-image-label">
                    {{ artist.name|default("PHOTO DE L'ARTISTE")|upper }}
                </span>
            </div>
            <div class="artiste-banner-text">
                <div class="artiste-banner-top">
                    <p class="artiste-banner-title">BIOGRAPHIE</p>
                </div>
                <div class="artiste-banner-center">
                    <p>{{ artist.biography|nl2br }}</p>
                </div>
                <div class="artiste-banner-bottom">
                    <div class="artiste-banner-bottom-title">CONTACT</div>
                    <div class="artiste-banner-contact">
                        {% if artist.social %}<div>{{ artist.social }}</div>{% endif %}
                        {% if artist.email %}<div>{{ artist.email }}</div>{% endif %}
                        {% if artist.phone %}<div>{{ artist.phone }}</div>{% endif %}
                        {% if not artist.social and not artist.email and not artist.phone %}
                            <div style="color:#888;">Aucune information de contact</div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="articles">
        <div class="articles-content">
            <div class="article-cards">
                {% for related in related_articles|default([]) %}
                    {% include 'components/_article_card.html.twig' with {article: {
                        id: related.id,
                        image: related.image,
                        title: related.title,
                        description: related.description
                    }, show_link: false} %}
                {% else %}
                    <p style="text-align:center;color:#888;padding:40px;">
                        Aucune autre œuvre pour le moment.
                    </p>
                {% endfor %}
            </div>
        </div>
    </section>

    {% if images|length > 1 %}
    <script>
        (function () {
            const main = document.getElementById('article-main-image');
            const thumbs = document.querySelectorAll('.article-thumb');
            const indexSpans = document.querySelectorAll('.article-image-index span');

            thumbs.forEach((thumb, idx) => {
                thumb.addEventListener('click', () => {
                    main.src = thumb.dataset.image;
                    thumbs.forEach(t => t.style.borderColor = 'transparent');
                    thumb.style.borderColor = '#000';

                    indexSpans.forEach(s => s.classList.remove('active'));
                    indexSpans[idx]?.classList.add('active');
                });
            });
        })();
    </script>
    {% endif %}
{% endblock %}
