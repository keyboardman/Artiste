{% extends 'base.html.twig' %}

{% block title %}Placeaupro - Accueil{% endblock %}

{% block body_class %}home-page{% endblock %}

{% block nav_style %}white{% endblock %}
{% block nav_transparent %}true{% endblock %}

{% block stylesheets %}
    <style>
        body.home-page {
            background-image: url("{{ asset('img/hero.png') }}");
        }
    </style>
{% endblock %}

{% block content %}
    <section id="hero">
        <div class="hero-content">
            <h1>DESIGN</h1>
            <p>
                Lorem Ipsum is simply dummy text of the printing and typesetting
                industry. Lorem Ipsum has been the industry's standard dummy text ever
                since the 1500s, when an unknown printer took a galley of type and
                scrambled it to make a type specimen book. It has survived not only
                five centuries
            </p>
        </div>
    </section>

    <section id="windows">
        <div class="hero-content">
            <div class="windows-container">
                <div class="window-card">
                    <img class="window-frame" src="{{ asset('img/window.png') }}" alt="Fenêtre" />
                    <div class="window-content">
                        <img src="{{ asset('img/image.png') }}" alt="Contenu 1" />
                    </div>
                </div>
                <div class="window-card">
                    <img class="window-frame" src="{{ asset('img/window.png') }}" alt="Fenêtre" />
                    <div class="window-content">
                        <img src="{{ asset('img/image.png') }}" alt="Contenu 2" />
                    </div>
                </div>
                <div class="window-card">
                    <img class="window-frame" src="{{ asset('img/window.png') }}" alt="Fenêtre" />
                    <div class="window-content">
                        <img src="{{ asset('img/image.png') }}" alt="Contenu 3" />
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
