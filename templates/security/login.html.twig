{% extends 'base.html.twig' %}

{% block title %}Connexion - Placeaupro{% endblock %}

{% block body_class %}login-page{% endblock %}

{# Navigation blanche #}
{% block nav_style %}white{% endblock %}

{# Pas de CSS responsive pour cette page #}
{% block responsive_css %}{% endblock %}

{% block content %}
    <main class="login-main">
        <div class="login-container">
            {{ form_start(loginForm, {
                'action': path('app_login'),
                'attr': {'class': 'login-form'}
            }) }}

            {# Affichage des erreurs globales #}
            {% if error %}
                <div class="login-error">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {# Messages flash de succès #}
            {% for message in app.flashes('success') %}
                <div class="login-success">
                    {{ message }}
                </div>
            {% endfor %}

            {{ form_row(loginForm.email) }}
            {{ form_row(loginForm.password) }}

            {# Token CSRF avec le nom attendu par form_login #}
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div style="text-align:right;margin:8px 0 16px;">
                <a href="{{ path('app_forgot_password') }}"
                   style="color:#666;font-size:13px;text-decoration:underline;">
                    Mot de passe oublié ?
                </a>
            </div>

            <div class="login-actions">
                <button type="submit" class="login-button login-button--secondary">
                    CONNEXION
                </button>
                <a href="{{ path('app_register') }}" class="login-button login-button--primary">
                    CRÉER MON COMPTE
                </a>
            </div>

            {{ form_rest(loginForm) }}
            {{ form_end(loginForm) }}
        </div>
    </main>
{% endblock %}
